{
  "name": "bunary",
  "version": "0.1.0",
  "description": "A Bun-first backend framework inspired by Laravel's elegant developer experience",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core.js",
      "types": "./dist/core.d.ts"
    },
    "./http": {
      "import": "./dist/http.js",
      "types": "./dist/http.d.ts"
    },
    "./auth": {
      "import": "./dist/auth.js",
      "types": "./dist/auth.d.ts"
    }
  },
  "files": [
    "dist",
    "logo.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts ./src/core.ts ./src/http.ts ./src/auth.ts --outdir ./dist --target bun --external @bunary/core --external @bunary/http --external @bunary/auth && bunx tsc -p tsconfig.build.json",
    "typecheck": "bunx tsc --noEmit"
  },
  "keywords": [
    "bunary",
    "bun",
    "backend",
    "framework",
    "laravel",
    "http",
    "router",
    "auth"
  ],
  "author": "Paul Radford",
  "license": "MIT",
  "homepage": "https://bunary.dev",
  "bugs": {
    "url": "https://github.com/bunary-dev/bunary/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@bunary/core": "^0.1.0",
    "@bunary/http": "^0.1.0",
    "@bunary/auth": "^0.1.0"
  },
  "devDependencies": {
    "bun-types": "^1.0.0",
    "typescript": "^5.0.0"
  }
}
