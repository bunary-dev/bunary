{
  "name": "bunary",
  "version": "0.4.0",
  "description": "A Bun-first backend framework inspired by Laravel's elegant developer experience",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./http/provider": {
      "types": "./dist/http-provider.d.ts",
      "import": "./dist/http-provider.js",
      "default": "./dist/http-provider.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./auth/provider": {
      "types": "./dist/auth-provider.d.ts",
      "import": "./dist/auth-provider.js",
      "default": "./dist/auth-provider.js"
    },
    "./orm": {
      "types": "./dist/orm.d.ts",
      "import": "./dist/orm.js",
      "default": "./dist/orm.js"
    },
    "./orm/provider": {
      "types": "./dist/orm-provider.d.ts",
      "import": "./dist/orm-provider.js",
      "default": "./dist/orm-provider.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && bun build ./src/index.ts ./src/core.ts ./src/http.ts ./src/http-provider.ts ./src/auth.ts ./src/auth-provider.ts ./src/orm.ts ./src/orm-provider.ts --outdir ./dist --target bun --external \"@bunary/*\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check ./src ./tests",
    "format": "biome check --write ./src ./tests",
    "pack:check": "bun pm pack --dry-run",
    "prepublishOnly": "bun run clean && bun run build && bun test && bun run typecheck"
  },
  "keywords": [
    "bunary",
    "bun",
    "backend",
    "framework",
    "laravel",
    "http",
    "router",
    "auth"
  ],
  "author": "Paul Radford",
  "license": "MIT",
  "homepage": "https://bunary.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/bunary-dev/bunary.git"
  },
  "bugs": {
    "url": "https://github.com/bunary-dev/bunary/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@bunary/auth": "^0.4.0",
    "@bunary/core": "^0.4.0",
    "@bunary/http": "^0.4.0",
    "@bunary/orm": "^0.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
